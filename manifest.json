{
  "manifest_version": 3,
  "name": "Car Deal Finder",
  "version": "1.0",
  "description": "Find the best value cars on DoneDeal",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.donedeal.ie/*"],
  "content_scripts": [
    {
      "matches": ["*://*.donedeal.ie/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Car Deal Finder"
  }
}
